# -*- mode: python; -*-

# ------------------------------------------------------------------
# Local Development Mode
# Allt i Docker Compose - postgres och nuxt
# ------------------------------------------------------------------

docker_compose('./docker-compose.yml')

# ------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------

dc_resource(
  'postgres',
  labels=['Database'],
)

# ------------------------------------------------------------------
# Nuxt App (Local Dev)
# ------------------------------------------------------------------

local_resource(
  'nuxt-dev',
  serve_cmd='''PORT=$(docker compose -f /home/simon/repos/matchmaker/environments/dev/docker-compose.yml port postgres 5432 | cut -d: -f2) && export DATABASE_URL="postgresql://matchmaker:matchmaker@localhost:$PORT/matchmaker" && export NUXT_IGNORE_LOCK=1 && bun run dev --host 0.0.0.0''',
  serve_dir='/home/simon/repos/matchmaker/src/nuxt',
  env={
    'NODE_ENV': 'development',
  },
  labels=['App'],
  resource_deps=['postgres'],
)

# ------------------------------------------------------------------
# Kopiera databas
# Automatiskt från main om vi är på en branch
# ------------------------------------------------------------------

local_resource(
  'copy-db',
  cmd='cd ../.. && bash scripts/copy-db.sh',
  labels=['Setup'],
  resource_deps=['postgres'],
)
