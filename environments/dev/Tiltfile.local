# -*- mode: python; -*-

# ==================================================================
# Matchmaker Development Environment - Local Mode
#
# Access the app at: http://localhost:3000
# pg-view: http://localhost:5050 (auto-starts with postgres)
# ==================================================================

# ------------------------------------------------------------------
# Local Development Mode
# Allt i Docker Compose - postgres och nuxt
# ------------------------------------------------------------------

docker_compose('./docker-compose.yml')

# ------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------

dc_resource(
  'postgres',
  labels=['Database'],
)

# ------------------------------------------------------------------
# pg-view setup
# ------------------------------------------------------------------

local_resource(
  'pgview',
  cmd = ["sh", "-c", """
    # Get the actual container name dynamically
    CONTAINER=$(docker compose -f /home/simon/repos/matchmaker/environments/dev/docker-compose.yml ps postgres --format '{{.Name}}')
    docker network create matchmaker-net 2>/dev/null || true
    docker network connect matchmaker-net $CONTAINER 2>/dev/null || true
    docker rm -f pgview 2>/dev/null || true
    docker run -d --name pgview --network matchmaker-net -p 5050:3000 -e DB_URL=postgresql://matchmaker:matchmaker@$CONTAINER:5432/matchmaker lcurrol/pg-view
    echo 'pg-view started successfully'
  """],
  labels = ["Database"],
  auto_init = True,
  resource_deps = ["postgres"],
)

# ------------------------------------------------------------------
# Nuxt App (Local Dev)
# ------------------------------------------------------------------

local_resource(
  'nuxt-dev',
  serve_cmd='''PORT=$(docker compose -f /home/simon/repos/matchmaker__worktrees/test/environments/dev/docker-compose.yml port postgres 5432 | cut -d: -f2) && export DATABASE_URL="postgresql://matchmaker:matchmaker@localhost:$PORT/matchmaker" && export NUXT_IGNORE_LOCK=1 && bun run dev --host 0.0.0.0''',
  serve_dir='/home/simon/repos/matchmaker__worktrees/test/src/nuxt',
  env={
    'NODE_ENV': 'development',
  },
  labels=['App'],
  resource_deps=['postgres'],
)

# ------------------------------------------------------------------
# Kopiera databas
# Automatiskt från main om vi är på en branch
# ------------------------------------------------------------------

local_resource(
  'copy-db',
  cmd='cd ../.. && bash scripts/copy-db.sh',
  labels=['Setup'],
  resource_deps=['postgres'],
)
