# -*- mode: python; -*-

# ------------------------------------------------------------------
# Local Development Mode
# Allt i Docker Compose - postgres och nuxt
# ------------------------------------------------------------------

docker_compose('./docker-compose.yml')

# ------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------

dc_resource(
  'postgres',
  labels=['Database'],
)

# ------------------------------------------------------------------
# Nuxt App (Docker Compose)
# ------------------------------------------------------------------

dc_resource(
  'app',
  labels=['App'],
  resource_deps=['postgres', 'copy-db'],
)

# ------------------------------------------------------------------
# Kopiera databas
# Automatiskt från main om vi är på en branch
# ------------------------------------------------------------------

local_resource(
  'copy-db',
  cmd='cd ../.. && bash scripts/copy-db.sh',
  labels=['Setup'],
  resource_deps=['postgres'],
)
