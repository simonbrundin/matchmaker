# Database
DATABASE_URL=postgresql://user:password@localhost:5432/matchmaker

# SMS Gateway
SMS_GATEWAY_URL=https://sms-gateway.example.com/api
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=

# Telegram
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=

# OpenAI (for AI-generated responses)
OPENAI_API_KEY=

# Court22 API (optional — falls back to hardcoded key if unset)
COURT22_API_KEY=

# Development: skip auth middleware (NEVER set to true in production)
SKIP_AUTH=false
